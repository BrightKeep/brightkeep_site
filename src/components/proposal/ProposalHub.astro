---
// Proposals hub — shown after authentication on /proposals/cloud9
---

<div class="min-h-screen bg-[#1B2A4A] flex flex-col">

  <!-- Header -->
  <header class="h-16 flex items-center justify-between px-6 border-b border-white/10 flex-shrink-0">
    <div class="flex items-center gap-2">
      <img src="/proposals/brightkeep-logo.png" alt="BrightKeep" class="h-8" />
      <span class="text-2xl leading-none" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
        <span class="text-white">Bright</span><span class="text-[#FF6B6B]">Keep</span>
      </span>
    </div>
    <img src="/proposals/cloud9-logo.png" alt="Cloud9 Consulting" class="h-8 rounded" />
  </header>

  <!-- Main content -->
  <main class="flex-1 flex flex-col items-center justify-center px-4 py-16">

    <!-- Heading -->
    <div class="text-center mb-12 hub-heading" style="opacity:0;transform:translateY(20px)">
      <p class="text-[#FF6B6B] text-xs font-bold uppercase tracking-widest mb-3">Cloud9 Consulting</p>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">Your Proposals</h1>
      <p class="text-white/50 text-base">Prepared for Cloud9 Consulting by BrightKeep &middot; Confidential</p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-3xl">

      <!-- Card 1: Visualisation Application -->
      <a
        href="/proposals/cloud9-visualisation"
        class="hub-card group block bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 border-2 border-transparent hover:border-[#FF6B6B]"
        style="opacity:0;transform:translateY(30px)"
      >
        <div class="h-48 overflow-hidden relative">
          <img
            src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&q=80&auto=format&fit=crop"
            alt="Data Visualisation Dashboard"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
        <div class="p-6">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#1B2A4A] text-white">Engineering</span>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#FF6B6B]/10 text-[#FF6B6B]">V1 + V2</span>
              </div>
              <h2 class="text-lg font-bold text-[#1B2A4A] mb-2 leading-snug">Visualisation Application</h2>
              <p class="text-sm text-[#6B7280] leading-relaxed">A purpose-built data visualisation platform connecting Salesforce, STP, and ServiceNow into a unified client intelligence dashboard.</p>
            </div>
            <div class="flex-shrink-0 mt-1">
              <div class="w-10 h-10 rounded-full bg-[#FF6B6B] flex items-center justify-center group-hover:bg-[#FF5252] group-hover:scale-110 transition-all duration-200">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </a>

      <!-- Card 2: AI Operations Platform -->
      <a
        href="/proposals/cloud9-ai"
        class="hub-card group block bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 border-2 border-transparent hover:border-[#FF6B6B]"
        style="opacity:0;transform:translateY(30px);transition-delay:0.15s"
      >
        <div class="h-48 overflow-hidden relative">
          <img
            src="https://images.unsplash.com/photo-1677442135703-1787eea5ce01?w=800&q=80&auto=format&fit=crop"
            alt="AI Operations Platform"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          <!-- NEW badge overlaid on image -->
          <span class="absolute top-4 right-4 px-2.5 py-1 rounded-full text-xs font-bold bg-[#FF6B6B] text-white shadow-lg">New</span>
        </div>
        <div class="p-6">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#1B2A4A] text-white">AI &amp; Automation</span>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">2026</span>
              </div>
              <h2 class="text-lg font-bold text-[#1B2A4A] mb-2 leading-snug">AI Operations Platform</h2>
              <p class="text-sm text-[#6B7280] leading-relaxed">A team of AI Specialists embedded in your Microsoft 365 environment, automating proposals, hiring, and operations across every sprint.</p>
            </div>
            <div class="flex-shrink-0 mt-1">
              <div class="w-10 h-10 rounded-full bg-[#FF6B6B] flex items-center justify-center group-hover:bg-[#FF5252] group-hover:scale-110 transition-all duration-200">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </a>

    </div>
  </main>

  <footer class="text-center text-white/25 text-xs py-6 flex-shrink-0">
    &copy; 2026 BrightKeep &mdash; Confidential. Prepared exclusively for Cloud9 Consulting.
  </footer>

</div>

<script is:inline>
  // Animate in on load
  document.addEventListener('DOMContentLoaded', () => {
    const heading = document.querySelector('.hub-heading');
    const cards = document.querySelectorAll('.hub-card');

    requestAnimationFrame(() => {
      if (heading) {
        heading.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
        heading.style.opacity = '1';
        heading.style.transform = 'translateY(0)';
      }
      cards.forEach((card, i) => {
        setTimeout(() => {
          card.style.transition = 'opacity 0.6s ease, transform 0.6s ease, box-shadow 0.3s ease, border-color 0.3s ease, translate 0.3s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, 200 + i * 150);
      });
    });
  });
</script>
