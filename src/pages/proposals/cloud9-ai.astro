      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {

          // Hero entrance
          setTimeout(() => {
            const heroLeft = document.querySelector('.hero-left');
            const heroRight = document.querySelector('.hero-right');
            const underline = document.querySelector('.hero-underline');
            if (heroLeft) { heroLeft.style.transition = 'opacity 0.9s ease, transform 0.9s ease'; heroLeft.style.opacity = '1'; heroLeft.style.transform = 'translateX(0)'; }
            if (heroRight) { setTimeout(() => { heroRight.style.transition = 'opacity 0.9s ease, transform 0.9s ease'; heroRight.style.opacity = '1'; heroRight.style.transform = 'translateX(0)'; }, 300); }
            if (underline) { setTimeout(() => underline.classList.add('active'), 700); }
          }, 100);

          // Progress bar
          const progressFill = document.getElementById('ai-progress-fill');
          function updateProgress() {
            if (!progressFill) return;
            const pct = (window.scrollY / Math.max(1, document.body.scrollHeight - window.innerHeight)) * 100;
            progressFill.style.width = pct + '%';
          }
          window.addEventListener('scroll', updateProgress, { passive: true });

          // Section dot nav
          const dots = document.querySelectorAll('.ai-dot');
          const sectionIds = ['s-hero','s-challenge','s-solution','s-specialists','s-delivery','s-benefits','s-summary'];
          const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

          dots.forEach(dot => {
            dot.addEventListener('click', () => {
              const target = document.getElementById(dot.dataset.target);
              if (target) target.scrollIntoView({ behavior: 'smooth' });
            });
          });

          // Reveal on scroll - handles all reveal variants
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
          document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .section-label-anim').forEach(el => revealObserver.observe(el));

          // Section dot active state
          const dotObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                dots.forEach(dot => dot.classList.toggle('active', dot.dataset.target === id));
              }
            });
          }, { threshold: 0.4 });
          sections.forEach(s => dotObserver.observe(s));

          // Challenge section animation
          const challengeSection = document.getElementById('s-challenge');
          let challengeAnimated = false;
          const challengeObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !challengeAnimated) {
              challengeAnimated = true;
              const label = document.querySelector('.challenge-label');
              const card1 = document.querySelector('.challenge-card-1');
              const card2 = document.querySelector('.challenge-card-2');
              const backlog = document.querySelector('.challenge-backlog');
              const animate = (el, delay, tx) => {
                if (!el) return;
                setTimeout(() => {
                  el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                  el.style.opacity = '1';
                  el.style.transform = tx || 'translateY(0)';
                }, delay);
              };
              animate(label, 0, 'translateY(0)');
              animate(card1, 200, 'translateX(0)');
              animate(card2, 380, 'translateX(0)');
              animate(backlog, 560, 'translateX(0)');
            }
          }, { threshold: 0.2 });
          if (challengeSection) challengeObserver.observe(challengeSection);

          // Architecture diagram animation
          const archSection = document.getElementById('s-solution');
          let archAnimated = false;
          const archObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !archAnimated) {
              archAnimated = true;
              const show = (ids, delay) => ids.forEach(id => {
                const el = document.getElementById(id);
                if (el) setTimeout(() => { el.style.opacity = '1'; }, delay);
              });
              show(['lbl-1','arch-sources'], 0);
              show(['arch-arrows-1','lbl-2'], 500);
              show(['arch-platform'], 700);
              show(['arch-arrows-2','lbl-3'], 1200);
              show(['arch-specialists'], 1400);
              show(['arch-arrows-3','lbl-4'], 1800);
              show(['arch-users'], 2000);
            }
          }, { threshold: 0.25 });
          if (archSection) archObserver.observe(archSection);

          // Smooth scroll for anchor links
          document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', (e) => {
              const target = document.getElementById(link.getAttribute('href').slice(1));
              if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
            });
          });

        });
      </script>
    </>
  )}
</ProposalLayout>
