                      </div>
                      <div>
                        <h3 class="text-lg font-bold text-[#1B2A4A] mb-1">Proposal Generation</h3>
                        <p class="text-sm text-[#6B7280]">A high-frequency, high-effort manual process</p>
                      </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                      {[
                        'Each proposal takes 2–4 hours to assemble manually',
                        'Past proposals must be manually searched through to reference',
                        'CV reformatting is repeated for every bid',
                        'No standardised template across proposal types',
                      ].map(pain => (
                        <div class="flex items-start gap-2.5 p-3 rounded-lg bg-red-50 border border-red-100">
                          <svg class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                          <span class="text-xs text-[#374151]">{pain}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Card 2: Team Profiles -->
                <div class="challenge-card-2 rounded-2xl border-2 border-[#3A6B9F] overflow-hidden shadow-lg" style="opacity:0;transform:translateX(-20px)">
                  <div class="h-1.5 bg-gradient-to-r from-[#3A6B9F] to-[#00B4D8]"></div>
                  <div class="p-6">
                    <div class="flex items-start gap-4 mb-5">
                      <div class="w-12 h-12 rounded-xl bg-[#3A6B9F]/8 flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6 text-[#3A6B9F]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                      </div>
                      <div>
                        <h3 class="text-lg font-bold text-[#1B2A4A] mb-1">Consultant Team Profiles</h3>
                        <p class="text-sm text-[#6B7280]">A time-consuming step repeated on every proposal submission</p>
                      </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                      {[
                        'CVs are manually reformatted for every individual bid',
                        'Same experience explained differently each time',
                        'No standard format adapted to brief requirements',
                        'Leadership time spent on formatting, not strategy',
                      ].map(pain => (
                        <div class="flex items-start gap-2.5 p-3 rounded-lg bg-blue-50 border border-blue-100">
                          <svg class="w-4 h-4 text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                          <span class="text-xs text-[#374151]">{pain}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Backlog column (right 1/3) -->
              <div class="challenge-backlog self-stretch" style="opacity:0;transform:translateX(20px)">
                <div class="rounded-2xl border-2 border-[#1B2A4A]/25 bg-[#1B2A4A]/3 p-5 h-full flex flex-col">
                  <div class="flex items-center gap-2 mb-5">
                    <div class="w-7 h-7 rounded-lg bg-[#1B2A4A] flex items-center justify-center flex-shrink-0">
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    </div>
                    <span class="text-xs font-bold text-[#1B2A4A] uppercase tracking-wider">Future phases</span>
                  </div>
                  <div class="space-y-2.5 flex-1">
                    {[
                      { label: 'Candidate Sourcing', sub: 'AI-assisted hiring pipeline', phase: 'Phase 2' },
                      { label: 'Meeting Notes', sub: 'Auto-transcription and summaries', phase: 'Phase 4' },
                      { label: 'Employment Contracts', sub: 'Template-driven generation', phase: 'Phase 4' },
                      { label: 'Timesheet Management', sub: 'Karmly and approval workflows', phase: 'Phase 4' },
                      { label: 'Tender Monitoring', sub: 'AusTender and state portals', phase: 'Phase 5' },
