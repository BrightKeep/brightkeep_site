        ))}
      </nav>

      <main class="pt-16">

        <!-- ════════════════════════════════════ SECTION 1: HERO -->
        <section id="s-hero" class="relative min-h-screen flex items-center overflow-hidden bg-[#0D1F3C]">
          <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
            {Array.from({length: 18}).map((_, i) => (
              <div class="particle absolute rounded-full" style={`width:${4+(i%5)*3}px;height:${4+(i%5)*3}px;left:${(i*17+5)%95}%;top:${(i*23+8)%90}%;background:${i%3===0?'#FF6B6B':i%3===1?'#00B4D8':'rgba(255,255,255,0.4)'};opacity:${0.2+(i%4)*0.1};animation:float-particle ${5+(i%6)}s ease-in-out ${(i*0.7)%4}s infinite alternate`}></div>
            ))}
