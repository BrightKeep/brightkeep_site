---
export const prerender = false;

import ProposalLayout from '../../layouts/ProposalLayout.astro';
import ProposalHeader from '../../components/proposal/ProposalHeader.astro';
import ProposalPasswordGate from '../../components/proposal/ProposalPasswordGate.astro';

const COOKIE_NAME = 'proposal_cloud9_auth';
const COOKIE_VALUE = 'authenticated';
const PASSWORD = import.meta.env.PROPOSAL_CLOUD9_PASSWORD || 'cloud9proposal';

let authenticated = false;
let showError = false;

const cookie = Astro.request.headers.get('cookie') || '';
if (cookie.includes(`${COOKIE_NAME}=${COOKIE_VALUE}`)) {
  authenticated = true;
}

if (Astro.request.method === 'POST' && !authenticated) {
  const formData = await Astro.request.formData();
  const submittedPassword = formData.get('password');
  if (submittedPassword === PASSWORD) {
    authenticated = true;
    Astro.cookies.set(COOKIE_NAME, COOKIE_VALUE, {
      path: '/proposals',
      maxAge: 60 * 60 * 24 * 7,
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
    });
  } else {
    showError = true;
  }
}
---

<ProposalLayout title="Cloud9 AI Operations Platform | BrightKeep">
  {!authenticated ? (
    <ProposalPasswordGate error={showError} />
  ) : (
    <>
      <ProposalHeader title="Cloud9 AI Operations Platform" />

      <div id="ai-progress" class="fixed top-16 left-0 right-0 z-40 h-0.5 bg-transparent">
        <div id="ai-progress-fill" class="h-full bg-[#FF6B6B] transition-none" style="width:0%"></div>
      </div>

      <nav id="section-dots" class="hidden lg:flex fixed right-5 top-1/2 -translate-y-1/2 z-40 flex-col gap-3" aria-label="Section navigation">
