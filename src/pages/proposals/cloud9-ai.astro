                      <div class="flex gap-1">
                        <div class="w-1.5 h-1.5 rounded-full bg-[#00B4D8] animate-bounce" style="animation-delay:0s"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-[#00B4D8] animate-bounce" style="animation-delay:0.15s"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-[#00B4D8] animate-bounce" style="animation-delay:0.3s"></div>
                      </div>
                      <span class="text-white/35 text-xs italic">Drafting executive summary for government panel opportunity...</span>
                    </div>
                  </div>
                  <div class="absolute -inset-4 bg-[#FF6B6B]/5 rounded-3xl blur-2xl -z-10"></div>
                </div>
              </div>
            </div>

            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
