                      <div class="flex items-start gap-3 p-3 rounded-lg bg-white border border-[#1B2A4A]/10 shadow-sm">
                        <div class="w-1.5 h-1.5 rounded-full bg-[#FF6B6B] flex-shrink-0 mt-1.5"></div>
                        <div class="flex-1 min-w-0">
                          <div class="text-xs font-semibold text-[#1B2A4A] truncate">{label}</div>
