                <!-- Platform box (Azure AI Foundry) -->
                <g id="arch-platform" style="opacity:0;transition:opacity 0.7s ease">
                  <rect x="300" y="50" width="320" height="240" rx="14" fill="rgba(255,255,255,0.04)" stroke="rgba(255,107,107,0.5)" stroke-width="2"/>
                  <rect x="300" y="50" width="320" height="30" rx="14" fill="rgba(255,107,107,0.15)"/>
                  <rect x="300" y="64" width="320" height="16" fill="rgba(255,107,107,0.15)"/>
                  <text x="460" y="70" text-anchor="middle" font-family="Inter,sans-serif" font-size="9.5" font-weight="700" fill="#FF6B6B" letter-spacing="0.08em">AZURE AI FOUNDRY</text>

                  <!-- Knowledge Base sub-box -->
                  <rect x="316" y="96" width="134" height="170" rx="8" fill="rgba(0,180,216,0.08)" stroke="#00B4D8" stroke-width="1"/>
                  <text x="383" y="114" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="#00B4D8">Knowledge Base</text>
                  {[
                    { y: 124, label: 'Document ingestion' },
                    { y: 143, label: 'AI Search index' },
                    { y: 162, label: 'Tagging & metadata' },
