        <section id="s-solution" class="py-24 bg-[#1B2A4A]">
          <div class="max-w-6xl mx-auto px-6 lg:px-12">

            <div class="text-center mb-16">
              <span class="section-label-anim inline-block px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-[#00B4D8]/15 text-[#00B4D8] mb-4 border border-[#00B4D8]/25">Platform Overview</span>
              <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">How the platform works</h2>
              <p class="text-white/50 text-lg max-w-2xl mx-auto">A central knowledge platform ingests Cloud9's existing data and connects to external tools. Named AI Specialists draw from that knowledge to assist your team.</p>
            </div>

            <!-- Architecture diagram -->
            <div id="arch-diagram" class="relative max-w-5xl mx-auto mb-16">
              <svg viewBox="0 0 960 340" xmlns="http://www.w3.org/2000/svg" class="w-full" style="overflow:visible">

                <!-- Column labels -->
                <text x="110" y="16" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="rgba(255,255,255,0.35)" letter-spacing="0.12em" id="lbl-1" style="opacity:0;transition:opacity 0.6s ease">DATA SOURCES</text>
                <text x="460" y="16" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="rgba(255,255,255,0.35)" letter-spacing="0.12em" id="lbl-2" style="opacity:0;transition:opacity 0.6s ease">THE PLATFORM</text>
                <text x="780" y="16" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="rgba(255,255,255,0.35)" letter-spacing="0.12em" id="lbl-3" style="opacity:0;transition:opacity 0.6s ease">SPECIALISTS</text>
                <text x="920" y="16" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="rgba(255,255,255,0.35)" letter-spacing="0.12em" id="lbl-4" style="opacity:0;transition:opacity 0.6s ease">USERS</text>

                <!-- Data sources column -->
                <g id="arch-sources" style="opacity:0;transition:opacity 0.7s ease">
                  <!-- Cloud9 data box -->
                  <rect x="10" y="30" width="200" height="130" rx="10" fill="rgba(0,180,216,0.08)" stroke="#00B4D8" stroke-width="1.5"/>
                  <text x="110" y="50" text-anchor="middle" font-family="Inter,sans-serif" font-size="9.5" font-weight="600" fill="#00B4D8">Cloud9 Data</text>
                  {[
                    { y: 68, label: 'Past Proposals' },
                    { y: 88, label: 'Consultant CVs' },
                    { y: 108, label: 'Delivery Documents' },
                    { y: 128, label: 'Branded Templates' },
                  ].map(({ y, label }) => (
                    <g>
                      <rect x="24" y={y} width="172" height="16" rx="4" fill="rgba(255,255,255,0.05)"/>
                      <circle cx="36" cy={y+8} r="3" fill="#00B4D8" opacity="0.6"/>
                      <text x="46" y={y+11} font-family="Inter,sans-serif" font-size="9" fill="rgba(255,255,255,0.65)">{label}</text>
                    </g>
                  ))}

                  <!-- External APIs box -->
                  <rect x="10" y="178" width="200" height="130" rx="10" fill="rgba(124,58,237,0.08)" stroke="rgba(124,58,237,0.5)" stroke-width="1.5"/>
                  <text x="110" y="198" text-anchor="middle" font-family="Inter,sans-serif" font-size="9.5" font-weight="600" fill="#7C3AED">External Systems</text>
                  {[
                    { y: 216, label: 'Karmly (hours & projects)' },
                    { y: 236, label: 'MYOB (financial data)' },
                    { y: 256, label: 'Seek (candidates - Phase 2)' },
                    { y: 276, label: 'Microsoft 365 (Graph API)' },
                  ].map(({ y, label }) => (
                    <g>
                      <rect x="24" y={y} width="172" height="16" rx="4" fill="rgba(255,255,255,0.05)"/>
                      <circle cx="36" cy={y+8} r="3" fill="#7C3AED" opacity="0.6"/>
                      <text x="46" y={y+11} font-family="Inter,sans-serif" font-size="9" fill="rgba(255,255,255,0.65)">{label}</text>
                    </g>
                  ))}
                </g>

                <!-- Arrows: sources → platform -->
                <g id="arch-arrows-1" style="opacity:0;transition:opacity 0.5s ease">
                  <line x1="210" y1="95" x2="296" y2="130" stroke="#00B4D8" stroke-width="1.5" stroke-dasharray="5,4"/>
                  <polygon points="292,125 300,132 295,137" fill="#00B4D8"/>
