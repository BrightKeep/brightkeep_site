          50% { transform: translateY(-10px); }
        }
        @keyframes scroll-dot-anim {
          0%, 100% { transform: translateY(0); opacity: 0.8; }
          50% { transform: translateY(10px); opacity: 0.3; }
        }
        .specialist-float {
          animation: specialist-float 4s ease-in-out infinite;
        }
        .scroll-dot {
          animation: scroll-dot-anim 1.8s ease-in-out infinite;
        }
        .hero-underline {
          transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.6s;
        }
        .hero-underline.active {
          transform: scaleX(1) !important;
        }
        .reveal {
          opacity: 0;
          transform: translateY(28px);
          transition: opacity 0.65s ease, transform 0.65s ease;
        }
        .reveal.visible {
          opacity: 1;
          transform: translateY(0);
        }
        html { scroll-behavior: smooth; }
        .specialist-card {
          transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .specialist-card:hover {
          transform: translateY(-4px);
        }
        .ai-dot.active {
          background: #FF6B6B !important;
          transform: scale(1.3);
        }
      </style>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {

          // ── Hero entrance
          setTimeout(() => {
            const heroLeft = document.querySelector('.hero-left');
            const heroRight = document.querySelector('.hero-right');
            const underline = document.querySelector('.hero-underline');
            if (heroLeft) { heroLeft.style.transition = 'opacity 0.9s ease, transform 0.9s ease'; heroLeft.style.opacity = '1'; heroLeft.style.transform = 'translateX(0)'; }
            if (heroRight) { setTimeout(() => { heroRight.style.transition = 'opacity 0.9s ease, transform 0.9s ease'; heroRight.style.opacity = '1'; heroRight.style.transform = 'translateX(0)'; }, 300); }
            if (underline) { setTimeout(() => underline.classList.add('active'), 600); }
          }, 100);

          // ── Scroll progress bar
          const progressFill = document.getElementById('ai-progress-fill');
          function updateProgress() {
            if (!progressFill) return;
            const scrollTop = window.scrollY;
            const docHeight = document.body.scrollHeight - window.innerHeight;
            const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            progressFill.style.width = pct + '%';
          }
          window.addEventListener('scroll', updateProgress, { passive: true });

          // ── Section dot nav
          const dots = document.querySelectorAll('.ai-dot');
          const sectionIds = ['s-hero','s-specialists','s-architecture','s-roadmap','s-sprint1','s-benefits','s-investment'];
          const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

          dots.forEach(dot => {
            dot.addEventListener('click', () => {
              const target = document.getElementById(dot.dataset.target);
              if (target) target.scrollIntoView({ behavior: 'smooth' });
            });
          });

          // ── Reveal on scroll (Intersection Observer)
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

          document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

          // ── Section dot active state
          const dotObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                dots.forEach(dot => {
                  dot.classList.toggle('active', dot.dataset.target === id);
                });
              }
            });
          }, { threshold: 0.4 });

          sections.forEach(s => dotObserver.observe(s));

          // ── Architecture diagram animation
          const archSection = document.getElementById('s-architecture');
          let archAnimated = false;
          const archObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && !archAnimated) {
              archAnimated = true;
              const z1 = document.getElementById('arch-zone-1');
              const z2 = document.getElementById('arch-zone-2');
              const z3 = document.getElementById('arch-zone-3');
              const a1 = document.getElementById('arch-arrow-1');
              const a2 = document.getElementById('arch-arrow-2');
              if (z1) z1.style.opacity = '1';
              setTimeout(() => { if (a1) a1.style.opacity = '1'; }, 400);
              setTimeout(() => { if (z2) z2.style.opacity = '1'; }, 600);
              setTimeout(() => { if (a2) a2.style.opacity = '1'; }, 1000);
              setTimeout(() => { if (z3) z3.style.opacity = '1'; }, 1200);
            }
          }, { threshold: 0.3 });
          if (archSection) archObserver.observe(archSection);

          // ── Smooth scroll for anchor links
          document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', (e) => {
              const id = link.getAttribute('href').slice(1);
              const target = document.getElementById(id);
              if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth' });
              }
            });
          });

        });
      </script>
    </>
